# ══════════════════════════════════════════════════════════════════
#  Falow — variáveis de ambiente
#  Copie este arquivo para .env.local e preencha cada valor.
#  Em produção (Cloudflare) estes valores vão como secrets do Worker
#  (wrangler secret put NOME). Operação: docs/operacao-saas.md
# ══════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────
# Painel Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ⚠️ Chave com acesso total ao banco — nunca exponha nem versione
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Meta / Instagram ───────────────────────────────────
# Painel do app Meta → produto Instagram → API setup with Instagram
# business login → Business login settings
INSTAGRAM_APP_ID=1234567890
INSTAGRAM_APP_SECRET=abc123
# App settings → Basic → App Secret (usado na assinatura dos webhooks)
META_APP_SECRET=abc123
# Segredo inventado por você — precisa ser IDÊNTICO ao digitado
# na configuração do webhook no painel Meta
META_VERIFY_TOKEN=falow-verify-2026
META_GRAPH_VERSION=v25.0

# ── Aplicação ──────────────────────────────────────────────────────
# URL pública do serviço. Dev: http://localhost:3000 (ou a URL do ngrok,
# para a Meta e a Stripe alcançarem seu computador).
# Produção: https://falow.app.br
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://falow.app.br

# Criptografia dos tokens do Instagram no banco (32 bytes em hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Segredo dos crons (/api/cron/sequences e /api/cron/purge) — invente um valor.
# Em produção os crons vêm do wrangler.toml; o scheduled() do Worker envia
# "Authorization: Bearer <CRON_SECRET>" sozinho. Em dev, chame a rota com esse
# header para testar.
CRON_SECRET=

# ── Assinatura (Stripe) ────────────────────────────────────────────
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Dashboard Stripe → Developers → Webhooks → endpoint
# https://falow.app.br/api/webhooks/stripe → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → Falow → preço mensal → API ID
STRIPE_PRICE_ID=price_...

# ── Dono da instalação ─────────────────────────────────────────────
# UUID do seu usuário no Supabase (Authentication → Users). O dono não
# paga, não tem limite de contas e é o único que vê o botão de IA.
FALOW_OWNER_USER_ID=

# ── IA nos campos do painel (opcional, só para o dono) ─────────────
# Com a chave preenchida, os campos de texto do painel do DONO ganham um
# botão que escreve o texto (resposta pública, boas-vindas, mensagem do
# workflow...). Clientes não veem o botão. Sem a chave, ele não aparece.
# Vai pro provedor só o que o dono digita no painel — nunca mensagem de seguidor.
OPENROUTER_API_KEY=
# Opcional. Padrão: anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=

# E-mail de contato exibido na landing (/) e nas três páginas públicas
# (/privacidade, /exclusao-de-dados, /termos-de-servico), para dúvidas,
# pedidos de exclusão e questões sobre os Termos.
# Sobrescreve o padrão de src/components/legal/legal-chrome.tsx. Também é o
# endereço para pedidos de reembolso (arrependimento de 7 dias). A Meta exige
# um canal de contato nas URLs cadastradas no painel.
NEXT_PUBLIC_CONTACT_EMAIL=
