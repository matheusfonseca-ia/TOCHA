# ══════════════════════════════════════════════════════════════════
#  InstaReply — variáveis de ambiente
#  Copie este arquivo para .env.local e preencha cada valor.
#  Guia completo: docs/guia-configuracao-instareply.pdf
# ══════════════════════════════════════════════════════════════════

# ── Supabase (Passo 1 do guia) ─────────────────────────────────────
# Painel Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ⚠️ Chave com acesso total ao banco — nunca exponha nem versione
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Meta / Instagram (Passo 2 do guia) ─────────────────────────────
# Painel do app Meta → produto Instagram → API setup with Instagram
# business login → Business login settings
INSTAGRAM_APP_ID=1234567890
INSTAGRAM_APP_SECRET=abc123
# App settings → Basic → App Secret (usado na assinatura dos webhooks)
META_APP_SECRET=abc123
# Segredo inventado por você — precisa ser IDÊNTICO ao digitado
# na configuração do webhook no painel Meta
META_VERIFY_TOKEN=instareply-verify-2026
META_GRAPH_VERSION=v25.0

# ── Aplicação ──────────────────────────────────────────────────────
# URL pública da instalação (produção: seu domínio; dev: URL do ngrok)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Criptografia dos tokens do Instagram no banco (32 bytes em hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Segredo do tick das Sequências (/api/cron/sequences) — invente um valor.
# O cron da Vercel envia "Authorization: Bearer <CRON_SECRET>" sozinho.
# Atrasos longos entre mensagens dependem desse tick: no plano Hobby da
# Vercel o cron roda só 1x/dia, então para precisão de minutos aponte um
# agendador externo gratuito (ex.: cron-job.org) para
# https://SEU-APP.vercel.app/api/cron/sequences?secret=<CRON_SECRET>
# a cada 1–5 minutos. Sem isso, os atrasos são retomados na próxima vez
# que qualquer mensagem/comentário chegar (tick oportunista do webhook).
CRON_SECRET=

# Não existe variável para travar o cadastro: assim que a primeira conta
# é criada no painel, o sistema tranca o cadastro sozinho (veja src/lib/config.ts).
