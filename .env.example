# ══════════════════════════════════════════════════════════════════
#  InstaReply — variáveis de ambiente
#  Copie este arquivo para .env.local e preencha cada valor.
#  Guia completo: docs/guia-configuracao-instareply.pdf
# ══════════════════════════════════════════════════════════════════

# ── Supabase (Passo 1 do guia) ─────────────────────────────────────
# Painel Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ⚠️ Chave com acesso total ao banco — nunca exponha nem versione
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Meta / Instagram (Passo 2 do guia) ─────────────────────────────
# Painel do app Meta → App settings → Basic
META_APP_ID=1234567890
META_APP_SECRET=abc123
# Segredo inventado por você — precisa ser IDÊNTICO ao digitado
# na configuração do webhook no painel Meta
META_VERIFY_TOKEN=instareply-verify-2026
META_GRAPH_VERSION=v21.0

# ── Aplicação ──────────────────────────────────────────────────────
# URL pública da instalação (produção: seu domínio; dev: URL do ngrok)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Criptografia dos tokens do Instagram no banco (32 bytes em hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Não existe variável para travar o cadastro: assim que a primeira conta
# é criada no painel, o sistema tranca o cadastro sozinho (veja src/lib/config.ts).
