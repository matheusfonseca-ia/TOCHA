# ══════════════════════════════════════════════════════════════════
#  Falow — variáveis de ambiente
#  Copie este arquivo para .env.local e preencha cada valor.
#  Em produção (Cloudflare) estes valores vão como secrets do Worker
#  (wrangler secret put NOME). Operação: docs/operacao-saas.md
# ══════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────
# Painel Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ⚠️ Chave com acesso total ao banco — nunca exponha nem versione
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Meta / Instagram ───────────────────────────────────
# Painel do app Meta → produto Instagram → API setup with Instagram
# business login → Business login settings
INSTAGRAM_APP_ID=1234567890
INSTAGRAM_APP_SECRET=abc123
# App settings → Basic → App Secret (usado na assinatura dos webhooks)
META_APP_SECRET=abc123
# Segredo inventado por você — precisa ser IDÊNTICO ao digitado
# na configuração do webhook no painel Meta
META_VERIFY_TOKEN=falow-verify-2026
META_GRAPH_VERSION=v25.0

# ── Aplicação ──────────────────────────────────────────────────────
# URL pública do app, SEMPRE com o /sistema (basePath do Next) e sem barra
# no fim: convites, success_url da Stripe, redirect do OAuth e os crons do
# Worker montam as URLs a partir dela. Sem o /sistema tudo cai na landing (404).
# Dev: http://localhost:3000/sistema (ou a URL do ngrok + /sistema, para a
# Meta e a Stripe alcançarem seu computador).
# Produção: https://falow.app.br/sistema
NEXT_PUBLIC_APP_URL=http://localhost:3000/sistema
# NEXT_PUBLIC_APP_URL=https://falow.app.br/sistema

# Criptografia dos tokens do Instagram no banco (32 bytes em hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Opcional, só durante a troca de chave: a chave anterior, para ainda abrir
# os tokens cifrados com ela. Remova depois que todos forem recifrados.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Segredo dos crons (/api/cron/sequences e /api/cron/purge) — invente um valor.
# Em produção os crons vêm do wrangler.toml; o scheduled() do Worker envia
# "Authorization: Bearer <CRON_SECRET>" sozinho. Em dev, chame a rota com esse
# header para testar.
CRON_SECRET=

# ── Assinatura (Stripe) ────────────────────────────────────────────
# Dashboard Stripe → Developers → API keys. Em dev use a chave de teste;
# use sk_live_ só nos secrets do Worker de produção.
STRIPE_SECRET_KEY=sk_test_...
# Dashboard Stripe → Developers → Webhooks → endpoint
# https://falow.app.br/sistema/api/webhooks/stripe → Signing secret
# (webhook da Meta: https://falow.app.br/sistema/api/webhooks/meta)
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → Falow → preço mensal → API ID
STRIPE_PRICE_ID=price_...

# ── Dono da instalação ─────────────────────────────────────────────
# UUID do seu usuário no Supabase (Authentication → Users). O dono não
# paga, não tem limite de contas e usa a chave de IA da instalação.
FALOW_OWNER_USER_ID=
# Opcional. Admins além do dono: UUIDs (Supabase → Authentication → Users →
# User UID) separados por vírgula, sem e-mails. Dão acesso ao painel /admin
# (clientes, cortesia, bloqueio). O dono não precisa estar na lista. Em
# produção muda só com: npx wrangler secret put FALOW_ADMIN_USER_IDS
FALOW_ADMIN_USER_IDS=
# Opcional. "true" exige MFA (nível AAL2 do Supabase Auth) para entrar no
# painel /admin. Vazio ou qualquer outro valor: não exige.
FALOW_ADMIN_REQUIRE_MFA=

# ── IA nos campos do painel (opcional) ─────────────────────────────
# Cada usuário pode cadastrar a PRÓPRIA chave na tela Contas do painel, da
# OpenRouter ou da OpenAI (fica criptografada, migrations 0016 e 0018).
# Estas variáveis são a chave padrão da instalação e valem SÓ para o dono e
# os admins (o custo é do dono): cliente sem chave própria fica sem o botão.
# Com alguma chave disponível, cada campo de texto do painel ganha um botão
# que escreve o texto (resposta pública, boas-vindas, mensagem do
# workflow...). Sem nenhuma, o botão não aparece e nada muda.
# Prioridade: chave do usuário, depois OPENROUTER_API_KEY, depois OPENAI_API_KEY.
# Vai pro provedor só o que o usuário digita no painel, nunca mensagem de seguidor.
OPENROUTER_API_KEY=
# Opcional. Padrão: anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=
# Alternativa à OpenRouter: chave direta da OpenAI (platform.openai.com/api-keys)
OPENAI_API_KEY=
# Opcional. Padrão: gpt-6-luna
OPENAI_MODEL=

# E-mail de contato exibido na landing (/) e nas três páginas públicas
# (/privacidade, /exclusao-de-dados, /termos-de-servico), para dúvidas,
# pedidos de exclusão e questões sobre os Termos.
# Sobrescreve o padrão de src/components/legal/legal-chrome.tsx. Também é o
# endereço para pedidos de reembolso (arrependimento de 7 dias). A Meta exige
# um canal de contato nas URLs cadastradas no painel.
NEXT_PUBLIC_CONTACT_EMAIL=
